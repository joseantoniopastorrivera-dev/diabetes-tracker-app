# Copia este archivo como .env y rellena tus valores. El .env nunca se sube.
TELEGRAM_BOT_TOKEN=pon_aqui_el_token_de_botfather
GEMINI_API_KEY=pon_aqui_tu_clave_de_gemini

# IDs de Telegram que pueden usar el bot, separados por comas.
# Para saber tu ID, escribe a @userinfobot en Telegram.
ALLOWED_USER_IDS=111111111,222222222

# Opcionales
GEMINI_MODEL=gemini-3.8-flash
# Para pruebas, apunta a otra BD y no toques la real:
DB_PATH=diabetes_tracker.db
